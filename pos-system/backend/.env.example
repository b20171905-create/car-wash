# Server
PORT=4000
JWT_SECRET=change_this_to_a_long_random_string

# Database type: postgres or mysql
DB_CLIENT=mysql

# Hostinger MySQL Database
# Note: If password contains special chars (@, #, $), URL-encode them:
# @ → %40
# # → %23
# $ → %24
DATABASE_URL=mysql://username:password@localhost:3306/database_name

# Initial owner account (development example only; change before real use)
OWNER_NAME=Owner
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=chnageme123

# WhatsApp Cloud API (Meta) - https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_TOKEN=your_meta_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_business_phone_number_id
WHATSAPP_API_VERSION=v20.0

# Owner's WhatsApp number to receive payment alerts (with country code, no +)
OWNER_WHATSAPP_NUMBER=91XXXXXXXXXX
